# Server-only configuration. Never use VITE_ for secrets.

# Grafilab: Gemini extraction and GLM-OCR.
GRAFILAB_API_KEY=
GRAFILAB_MODEL=gemini/gemini-3.5-flash-lite
GRAFILAB_VISION_MODEL=gemini/gemini-3.5-flash-lite
GRAFILAB_OCR_MODEL=grafilab/glm-ocr

# TypeSafe: Jev routing. The backup should belong to a separate account.
TYPESAFE_API_KEY=
TYPESAFE_BACKUP_API_KEY=
JEV_MODEL=jev-1.13.0

# Optional generic HTTPS OpenAI-compatible fallback.
# AI_BASE_URL must be an HTTPS endpoint, including /v1 when required.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
